# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in with actual values.
# IMPORTANT: .env is gitignored and should NEVER be committed to version control.
# Only this .env.example template is committed.
# ============================================================================

# Application Base URL
# The root URL of the application being tested
BASE_URL=https://zincbank.cydeo.io

# Test User Credentials
# Email address of test user for authentication testing
TEST_USER=student10@zinc.test

# Test User Password
# Password for the test user (keep this secret in CI/CD systems)
TEST_PASSWORD=ZQZSCb06TNaP

# ============================================================================
# Optional: CI/CD Environment Variables
# These can be injected by Jenkins or other CI systems
# ============================================================================

# CI Flag (set to 'true' in Jenkins to enable CI-specific behaviors)
# CI=true

# Playwright Report Directory (useful for CI systems)
# PLAYWRIGHT_REPORT_DIR=playwright-report

# Test Timeout Multiplier (increase if running on slower CI agents)
# TEST_TIMEOUT_MULTIPLIER=1
